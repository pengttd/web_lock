<?xml version="1.0" encoding="utf-8"?>
<resources>
    <color name="surface">#FFFFFF</color>
    <color name="background">#F3F6FA</color>
    <color name="ink">#142338</color>
    <color name="muted">#42556D</color>
    <color name="accent">#1255AC</color>
    <color name="error">#A32424</color>
    <style name="AppTheme" parent="android:style/Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/accent</item>
        <item name="android:windowBackground">@color/background</item>
        <item name="android:statusBarColor">@color/surface</item>
        <item name="android:navigationBarColor">@color/surface</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
